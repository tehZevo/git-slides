{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tehZevo/git-slides/schema.json",
  "title": "Git Slides deck",
  "type": "object",
  "required": ["slides"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layout": { "enum": ["title", "note"] },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "meta": {
          "type": "array",
          "items": { "type": "string" }
        },
        "markdown": { "type": "string" },
        "diffs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diff" }
        }
      }
    },
    "diff": {
      "type": "object",
      "required": ["path", "diff"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "diff": { "type": "string" }
      }
    }
  }
}
